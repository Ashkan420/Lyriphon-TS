{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["WebWorker", "ES2020", "DOM"],
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/**/*", "test/**/*"]
}
